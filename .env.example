# Optional: repo URL (used only when GITHUB_PAGES=true for basePath /REPO_NAME)
GITHUB_REPO=https://github.com/Alirezaanorouzi/onlinshop.git

# Static GitHub Pages export only (CI sets this). Never set on Liara — breaks CSS/assets.
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=   # only for subpath hosting; leave unset on Liara

# --- Liara / v2 backend ---
# CATALOG_BACKEND=json|sqlite   (default: json)
# SQLITE_PATH=data/catalog.sqlite

# Local SeaweedFS: npm run storage:up && npm run storage:init (see docker/seaweed-s3.json)
# Without S3_* set, uploads fall back to public/uploads/
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=onlineshop
S3_ACCESS_KEY=onlineshop
S3_SECRET_KEY=onlineshop-dev-secret
S3_PUBLIC_BASE_URL=http://127.0.0.1:8888/buckets/onlineshop
S3_FORCE_PATH_STYLE=true

# Store owner — same /login OTP as customers; this phone gets admin role
# ADMIN_PHONE=09121234567
# Optional: ADMIN_EMAIL=admin@example.com
# Optional legacy: ADMIN_PASSWORD=...
# Local: npm run db:seed-admin  |  Liara: node scripts/liara-sync-admin-env.mjs

# Legacy API token (optional; cookie session preferred)
# ADMIN_TOKEN=

# Customer OTP login (Kavenegar Verify Lookup — template name in panel, e.g. loginotp)
# KAVENEGAR_API_KEY=
# KAVENEGAR_VERIFY_TEMPLATE=loginotp
# Liara: node scripts/liara-sync-kavenegar-env.mjs

# New order alert (private Telegram channel — bot must be channel admin)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=   # or CHANNEL_ID=-100...
# TELEGRAM_NOTIFY_ENABLED=true
# Liara: node scripts/liara-sync-telegram-env.mjs

# Public shop URL for share links & Open Graph (same as SITE_URL on Liara)
# SITE_URL=https://your-domain.ir
