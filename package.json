{
  "name": "onlineshop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/static-export-build.mjs",
    "start": "npm run db:migrate && next start",
    "start:with-migrate": "node scripts/start-production.mjs",
    "lint": "eslint",
    "db:migrate": "node ./node_modules/tsx/dist/cli.mjs scripts/migrate.ts",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs scripts/seed.ts",
    "db:seed-admin": "node ./node_modules/tsx/dist/cli.mjs scripts/seed-admin.ts",
    "storage:up": "docker compose up -d",
    "storage:down": "docker compose down",
    "storage:init": "tsx scripts/init-seaweed-bucket.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.20.5",
    "zarinpal-node-sdk": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
